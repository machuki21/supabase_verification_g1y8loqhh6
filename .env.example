# Copy to .env and edit. Every setting is optional.

# Server (127.0.0.1 = only this computer can open it; use 0.0.0.0 to reach it from your phone on the same Wi-Fi)
HOST=127.0.0.1
PORT=3000

# BidRL locations to watch, by name (comma-separated). Leave empty to watch every location.
BIDRL_LOCATIONS=Turlock,Modesto
# How often to re-check BidRL, in minutes (min 5). BidRL's terms discourage automated
# monitoring, so keep this modest.
POLL_MINUTES=30

# Phone reminder this many minutes before a starred ("Want") item ends. Needs NTFY_URL or ALERT_WEBHOOK_URL.
WATCH_REMIND_MINUTES=30

# Amazon price lookups (paid API; leave blank to use listed retail + your own prices only)
#   serpapi    -> https://serpapi.com (Amazon Search engine)
#   rainforest -> https://www.rainforestapi.com
AMAZON_PROVIDER=
AMAZON_API_KEY=
AMAZON_DAILY_LOOKUPS=100
AMAZON_LOOKUPS_PER_CYCLE=25
# Only spend lookups on items ending within this many hours.
AMAZON_LOOKUP_WINDOW_HOURS=24
AMAZON_CACHE_DAYS=3
# 0-1. How closely the Amazon title must match before its price is trusted.
AMAZON_MIN_CONFIDENCE=0.6

# Bid-rule defaults (also editable in the app under "Bid rules")
TARGET_SAVINGS_PCT=40
# Stanislaus County (Turlock/Modesto) sales tax. Check the current rate at cdtfa.ca.gov.
SALES_TAX_PCT=8.875
EXTRA_FEE_PER_ITEM=0
TRUST_LISTED_RETAIL=true

# Phone alerts for great deals (optional). ntfy: install the ntfy app and subscribe to your topic.
NTFY_URL=
# Or a Discord/Slack incoming-webhook URL
ALERT_WEBHOOK_URL=
ALERT_MIN_SAVINGS_PCT=50
ALERT_ENDS_WITHIN_HOURS=6
ALERT_MIN_REFERENCE_PRICE=40
